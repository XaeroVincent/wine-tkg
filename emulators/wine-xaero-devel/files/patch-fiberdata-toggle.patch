--- dlls/ntdll/unix/virtual.c.orig	2026-09-21 17:38:57.590648000 -0700
+++ dlls/ntdll/unix/virtual.c	2026-09-21 18:05:29.805931000 -0700
@@ -3992,11 +3992,26 @@ NTSTATUS virtual_relocate_module( void *module )
     return STATUS_SUCCESS;
 }
 
+/* runtime toggle for the 0x1e00 FiberData sentinel (see commit 5f47658c5ca488a518cf0fcd9623d3e4234b1602)
+ * some titles' anti-tamper/DRM layers read FS:[0x10] directly and behave differently once this
+ * matches real Windows; set WINE_LEGACY_FIBERDATA=1 to restore the old (NULL) behavior */
+static BOOL use_legacy_fiberdata(void)
+{
+    static int cached = -1;
+    if (cached == -1)
+    {
+        const char *e = getenv( "WINE_LEGACY_FIBERDATA" );
+        cached = (e && atoi( e ));
+        if (cached) ERR( "WINE_LEGACY_FIBERDATA set, using legacy (NULL) TEB FiberData\n" );
+    }
+    return cached;
+}
 
 /* set some initial values in a new TEB */
 static void init_teb( struct thread_data *data, void *ptr )
 {
     TEB *teb = ptr;
+    ULONG_PTR fiber_data = use_legacy_fiberdata() ? 0 : 0x1e00;
 
 #ifdef _WIN64
     if (wow_peb)
@@ -4006,7 +4021,7 @@ static void init_teb( struct thread_data *data, void *
         teb32->Peb = PtrToUlong( wow_peb );
         teb32->Tib.Self = PtrToUlong( teb32 );
         teb32->Tib.ExceptionList = ~0u;
-        teb32->Tib.FiberData = 0x1e00;
+        teb32->Tib.FiberData = fiber_data;
         teb32->ClientId.UniqueProcess = pid;
         teb32->ClientId.UniqueThread  = data->tid;
         teb32->ActivationContextStackPointer = PtrToUlong( &teb32->ActivationContextStack );
@@ -4030,7 +4045,7 @@ static void init_teb( struct thread_data *data, void *
         teb64->Peb = PtrToUlong( wow_peb );
         teb64->Tib.Self = PtrToUlong( teb64 );
         teb64->Tib.ExceptionList = PtrToUlong( teb );
-        teb64->Tib.FiberData = 0x1e00;
+        teb64->Tib.FiberData = fiber_data;
         teb64->ClientId.UniqueProcess = pid;
         teb64->ClientId.UniqueThread  = data->tid;
         teb64->ActivationContextStackPointer = PtrToUlong( &teb64->ActivationContextStack );
@@ -4050,7 +4065,7 @@ static void init_teb( struct thread_data *data, void *
     teb->Peb = peb;
     teb->Tib.Self = &teb->Tib;
